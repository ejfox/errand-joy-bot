# errand-joy-bot gate environment. Copy to INSTALL_DIR/.env (mode 600, gitignored) and
# fill it ON the host that runs the gate. Never commit the real file.
#
#   ops/set-key.sh --generate GATE_AGENT_TOKEN     mint random tokens on the box (prints only ...last4)
#   ops/set-key.sh NOTIFY_DM_TOKEN                  paste a value at a hidden prompt, or pipe it in
#   ops/keys-from-clipboard.sh VENDOR_API_KEY       (macOS, optional) clipboard -> ssh -> set-key.sh
#
# Values must not contain whitespace, quotes, backslashes, $ or #.
# Policy (tiers, caps, joy budget, quiet hours, vendors) is NOT here: it is in config.toml.

# ── gate auth ──────────────────────────────────────────────────────────────
# Agents hold ONLY this token. It can submit requests and read status/budgets; nothing else.
GATE_AGENT_TOKEN=
# Cron and bin/buy admin commands (tick, reconcile, fund-add, stop, rate). Never give it to an agent.
GATE_ADMIN_TOKEN=

# ── gate listener (private; keep it on loopback) ───────────────────────────
GATE_HOST=127.0.0.1
GATE_PORT=47400

# ── paths ──────────────────────────────────────────────────────────────────
# SQLite ledger, STOP file. Use an absolute path in production (INSTALL_DIR/data).
DATA_DIR=./data
# Policy file. Start from examples/config.example.toml.
CONFIG_PATH=./config.toml

# ── safety ─────────────────────────────────────────────────────────────────
# 1 = no real orders are ever placed (vendor place() is never called). Default everywhere.
# Set 0 only on the production host, after a full dry run with the mock vendor.
DRY_RUN=1

# ── owner notifications (the DM is the approval channel) ───────────────────
# Transport name: "ntfy" (push via ntfy; the zero-infra option) or "http-dm" (POSTs
# {userId, message} with a Bearer token to your own DM endpoint). Both need a message id
# back. See docs/notifiers.md.
NOTIFIER=http-dm

# ntfy (NOTIFIER=ntfy). Server: https://ntfy.sh by default, or your own (https, or http
# only on loopback). Its host is added to the gate's --allow-net by ops/install.sh.
NTFY_URL=https://ntfy.sh
# On public ntfy.sh the topic name IS the secret: anyone who knows it reads your approval
# links. Make it long and random (24+ chars required on ntfy.sh), or self-host ntfy:
#   ops/set-key.sh --generate NTFY_TOPIC
NTFY_TOPIC=
# Optional ntfy access token (self-hosted ntfy with auth, or a reserved topic). Sent as Bearer.
NTFY_TOKEN=

# http-dm (NOTIFIER=http-dm). https anywhere, or plain http only on loopback (e.g. a local
# bot's DM endpoint).
NOTIFY_DM_URL=http://127.0.0.1:8787/api/dm
NOTIFY_DM_TOKEN=
# The owner's id on the chat platform (e.g. a Discord user id).
NOTIFY_USER_ID=

# Optional: executable run for two generic infra alerts (DM path down >2h, STOP tripped).
# It receives only a short fixed text; purchase details and links never go this way.
# Leave empty to disable.
HEALTH_ALERT_CMD=

# ── approval relay (the only public piece; see ops/relay-deploy.md) ────────
# Where the gate pushes approval records and pulls verdicts.
RELAY_URL=https://approve.example.com
# Origin used to build the links in the owner's DM. Usually the same as RELAY_URL.
RELAY_PUBLIC_URL=https://approve.example.com
# Shared secret between gate and relay, 32+ random chars. Same value on the relay side.
RELAY_TOKEN=

# ── relay-side settings (set these where the RELAY runs, not on the gate) ──
# Listed here for reference; the relay reads only its own environment.
#   RELAY_TOKEN        same value as above (or the file <relay>/data/.relay-token)
#   RELAY_DATA_DIR     default <relay>/data
#   RELAY_STORE        sqlite (default) | kv  (kv = Deno KV, for Deno Deploy;
#                      locally kv needs deno --unstable-kv)
#   RELAY_KV_PATH      optional Deno KV path when RELAY_STORE=kv
#   RELAY_IP_HEADER    cf-connecting-ip (default) | x-forwarded-for (first hop) | none
#                      (none = one shared rate-limit bucket; deny taps are never limited)
#   RELAY_MAX_CENTS    largest amount the relay accepts in a record (default 100000)
#   RELAY_TIMEZONE     time zone for times shown on the page (default UTC)

# ── vendor keys (all commented until you add a real adapter) ───────────────
# One key per app per host, named on the vendor dashboard as <app>-<host>-<yyyy-mm>
# (e.g. errand-joy-bot-myhost-2026-10), with a vendor-side spend cap of about 2-3x
# expected monthly use. Prepaid balances are their own cap: keep them small.
# See docs/vendors.md.
#
# EXAMPLEVENDOR_API_KEY=
#
# Prodigi (prints; card on file = a Privacy merchant-locked card). Sandbox unless production.
# PRODIGI_API_KEY=
# PRODIGI_ENV=sandbox
#
# Mouser (electronics; card on file = a Privacy merchant-locked card). Two keys from My Mouser > APIs.
# MOUSER_SEARCH_API_KEY=
# MOUSER_ORDER_API_KEY=
# MOUSER_CARD_LAST4=
