{
  "tasks": {
    "test": "deno test --allow-read --allow-write=/tmp --allow-env --allow-net=127.0.0.1 --unstable-kv gate relay",
    "test:gate": "deno test --allow-read --allow-write=/tmp --allow-env --allow-net=127.0.0.1 --unstable-kv gate",
    "test:relay": "deno test --allow-read --allow-write=/tmp --allow-env --unstable-kv relay/main_test.ts",
    "check": "deno check gate/main.ts relay/main.ts",
    "lint": "deno lint gate relay",
    "hooks": "git config core.hooksPath .githooks && chmod +x .githooks/* && echo 'secret-blocking git hooks enabled'",
    "start":"deno run --allow-read --allow-write --allow-env --allow-net gate/main.ts"
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/toml": "jsr:@std/toml@^1"
  },
  "exclude": ["plugin"]
}
